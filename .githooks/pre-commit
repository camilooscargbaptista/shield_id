#!/usr/bin/env bash
# pre-commit gate — FAIL-CLOSED (PORT-1.1 hardening, 2026-07-21).
# Runs the invariant guards on exactly the files staged for this commit.
# NUL-separated hand-off: filenames with spaces/accents no longer break the gate
# (the old unquoted $FILES word-split them). Empty staging is reported explicitly
# instead of silently scanning nothing.
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"

FILES=()
while IFS= read -r -d '' f; do
  FILES+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "${#FILES[@]}" -eq 0 ]; then
  echo "pre-commit gates: no staged files to scan — OK"
  exit 0
fi

python3 "$ROOT/scripts/guards/no_raw_biometric.py" "${FILES[@]}"
python3 "$ROOT/scripts/guards/no_real_pii.py" "${FILES[@]}"
python3 "$ROOT/scripts/guards/secret_scan.py" "${FILES[@]}"
python3 "$ROOT/scripts/guards/no_hardcoded.py" "${FILES[@]}"
echo "pre-commit gates: OK"
